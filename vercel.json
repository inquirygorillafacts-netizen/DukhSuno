{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": [
    "bom1"
  ],
  "env": {
    "NEXT_PUBLIC_BASE_URL": "https://bigsuno.app"
  },
  "crons": [
    {
      "path": "/api/admin/cron/cleanup-sessions",
      "schedule": "*/10 * * * *"
    }
  ]
}